---
import Layout from '../layouts/Layout.astro';
import Modal from '../components/Modal.jsx';
---

<Layout title="Sign Up | Poker Infinity">
    <div class="h-[50rem] max-w-7xl mx-auto px-4 flex">
        <div class="flex flex-col justify-center items-start grow">
            <h1 class="font-extrabold text-[3.75rem]">Sign Up</h1>

            <form class="flex flex-col mt-10 w-full pr-40">
                <input 
                    type="text" 
                    id="email" 
                    class="bg-[#212121] bg-[url('/mail.svg')] bg-no-repeat bg-[center_left_1rem] pl-10 pr-3 py-4 rounded text-[#807E7E] text-sm placeholder:text-sm placeholder:text-[#807E7E] tracking-wide" 
                    placeholder="Email"
                >
                <input 
                    type="password" 
                    id="password" 
                    class="bg-[#212121] px-3 py-4 mt-4 rounded text-[#807E7E] text-sm placeholder:text-sm placeholder:text-[#807E7E] tracking-wide" 
                    placeholder="Enter your password"
                >
                <input 
                    type="password" 
                    id="password" 
                    class="bg-[#212121] px-3 py-4 mt-4 rounded text-[#807E7E] text-sm placeholder:text-sm placeholder:text-[#807E7E] tracking-wide" 
                    placeholder="Confirm your password"
                >
                <div class="relative mt-6 flex">  
                    <input 
                        type="checkbox" 
                        checked 
                        id="checkbox"
                        class="invisible"
                    >
                    <label 
                        for="checkbox"
                        class="text-sm rounded-full cursor-pointer w-5 h-5 absolute left-0 top-0 border border-white p-2 after:content-[''] after:border-2 after:border-white after:border-t-0 after:border-r-0 after:left-[3px] after:top-[5px] after:-rotate-45 after:absolute after:h-1.5 after:w-3 after:opacity-0"    
                    >
                    </label>
                    <p class="text-sm ml-4 tracking-wide"><span class="text-[#807E7E]">I Accept</span> Terms & Conditions</p>
                </div>
                <Modal client:idle />
            </form>

            <div class="flex mt-6">
                <p class="text-[#807E7E] text-sm tracking-wide mr-2">Already have an account?</p>
                <a href="/login" class="text-sm tracking-wide">Sign In</a>
            </div>
        </div>
        <div class="bg-gray-light flex items-center w-3/5">
            <img src="/img/onboarding.png" class="">
        </div>
    </div>
</Layout>
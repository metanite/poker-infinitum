---
import Layout from '../layouts/Layout.astro';
import Features from "../components/Features.astro";
---

<Layout title="Home | Poker Infinity">
	<main>
        <div class="relative">
            <div class="h-[877px] bg-black">
                <div class="py-48 bg-[url('/img/header.png')] bg-auto bg-no-repeat bg-center">
                    <div class="max-w-7xl px-4 mx-auto">
                        <div class="w-[60%]">
                            <h1 class="text-[60px] tracking-wide font-extrabold leading-tight ">The Future of <br/> Digital Poker is here!</h1>
                            <p class="w-[75%] text-xl tracking-wide leading-1  mt-4">
                                This app allows you to create and host live poker games with friends and family - 
                                without the need of physical poker chips or playing cards
                            </p>
                            <button  
                                class="px-16 py-[18px] bg-blue text-white font-semibold tracking-wide rounded outline-none text-2xl mt-6"
                            >   
                                <a href="/#" class="button">Start Playing</a>
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="absolute inset-x-0 -bottom-[191px] max-w-7xl mx-auto px-20 py-2 bg-gray-light rounded-[51px]">
                <div class="flex justify-between items-center">
                    <div class="flex flex-col grow">
                        <div>
                            <h1 class=" text-6xl font-extrabold">$40 Free Credits</h1>
                        </div>
                        <div>
                            <p class="text-xl mt-4">Make sure you use these free credits when you register!</p>
                        </div>
                        <div>
                            <button 
                                class="px-10 py-[18px] bg-blue text-white font-semibold tracking-wide rounded outline-none text-2xl mt-6"
                            >
                                <a href="/#" class="button">Claim Now</a>
                            </button>
                        </div>
                    </div>
                    <div class="w-1/2 flex justify-end">
                        <img src="/img/pokerchips1.png" alt="pokerchips">
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-gray-dark pt-[374px] pb-[182px]">
            <Features />
        </div>

        <div class="bg-gray-light relative">
            <img src="/img/pokerchips-3.png" alt="pokerchips and cards 3" class="absolute left-0 -top-[95px]">
            <img src="/img/pokerchips-4.png" alt="pokerchips and cards 4" class="absolute right-0 -top-[95px]">
            <div class="flex flex-col items-center justify-center py-20">
                <div>
                    <h2 class="font-extrabold text-4xl uppercase tracking-wide">Summary of the poker infinity players</h2>
                </div>
                <div>
                    <p class="text-xl mt-6 tracking-wide leading-normal">We do our best to stay connected with our users around the world!</p>
                </div>
                <div class="w-2/5 flex justify-between mt-16">
                    <div class="flex flex-col items-center">
                        <h1 class="text-[89px] text-[#68E1EB] font-bold">1,200</h1>
                        <p class="text-xl">Registered Players</p>
                    </div>
                    <div class="flex flex-col items-center">
                        <h1 class="text-[89px] text-[#6177F5] font-bold">50</h1>
                        <p class="text-xl">Distributors</p>
                    </div>
                    <div class="flex flex-col items-center">
                        <h1 class="text-[89px] text-[#6177F5] font-bold">500</h1>
                        <p class="text-xl">Active Players</p>
                    </div>
                </div>
            </div>
        </div>
	</main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Features from "../components/Features.astro";
---

<Layout title="Home | Poker Infinity">
	<main>
        <div class="relative">
            <div class="h-[877px] bg-black">
                <div class="py-48 bg-[url('/img/header.png')] bg-top bg-auto bg-no-repeat md:bg-center">
                    <div class="max-w-7xl px-4 mx-auto">
                        <div class="w-full md:w-[60%] flex flex-col items-center justify-center md:block">
                            <h1 class="text-center md:text-left text-[2.8125rem] md:text-[60px] tracking-wide font-extrabold leading-tight ">The Future of <br class="hidden md:block"/> Digital Poker is here!</h1>
                            <p class="text-center md:text-left text-sm md:text-xl w-[90%] md:w-[75%] tracking-wide leading-normal md:leading-1 mt-3.5 md:mt-4">
                                This app allows you to create and host live poker games with friends and family - 
                                without the need of physical poker chips or playing cards
                            </p>
                            <button  
                                class="px-11 py-3  md:px-16 md:py-[18px] bg-blue text-white font-semibold tracking-wide rounded outline-none text-sm md:text-2xl mt-12 md:mt-6"
                            >   
                                <a href="/#" class="button">Start Playing</a>
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="absolute inset-x-0 -bottom-[32px] md:-bottom-[191px] max-w-7xl mx-10 md:mx-auto px-5 py-4 md:px-20 md:py-2 bg-gray-light rounded-[1.3125rem] md:rounded-[51px]">
                <div class="flex justify-between items-center">
                    <div class="flex flex-col grow">
                        <div>
                            <h1 class="text-2xl md:text-5xl xl:text-6xl font-extrabold">$40 Free Credits</h1>
                        </div>
                        <div>
                            <p class="text-sm md:text-xl mt-4">Make sure you use these free credits when you register!</p>
                        </div>
                        <div>
                            <button 
                                class="px-[3.1875rem] py-2.5 md:px-10 md:py-[18px] bg-blue text-white font-semibold tracking-wide rounded outline-none text-sm md:text-2xl mt-6"
                            >
                                <a href="/#" class="button">Claim Now</a>
                            </button>
                        </div>
                    </div>
                    <div class="lg:w-1/2 flex justify-end">
                        <img src="/img/pokerchips1.png" alt="pokerchips">
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-gray-dark pt-[70px] md:pt-[374px] pb-[182px]">
            <Features />
        </div>

        <div class="bg-gray-light relative">
            <img src="/img/pokerchips-3.png" alt="pokerchips and cards 3" class="w-40 md:w-56 xl:w-auto absolute -left-[64px] lg:left-0 top-[164px] lg:-top-[95px]">
            <picture class="w-36 md:w-56 xl:w-auto absolute right-0 top-[500px] lg:-top-[95px]">
                <source media="(min-width:768px)" srcset="/img/pokerchips-4.png"></source>
                <img src="/img/pokerchips-4-sm.png" alt="pokerchips and cards 4">
            </picture>
            
            <div class="flex flex-col items-center justify-center py-20">
                <div>
                    <h2 class="w-[80%] lg:w-auto mx-auto text-center xl:text-left font-extrabold text-4xl uppercase tracking-wide leading-normal md:leading-1">Summary of the poker infinity players</h2>
                </div>
                <div>
                    <p class="w-[70%] mx-auto md:w-auto text-center md:text-left text-sm md:text-xl mt-6 tracking-wide leading-relaxed">We do our best to stay connected with our users around the world!</p>
                </div>
                <div class="w-full md:w-1/2 2xl:w-2/5 flex flex-col lg:flex-row justify-between mt-8 lg:mt-16 space-y-10 md:space-y-0">
                    <div class="flex flex-col items-center">
                        <h1 class="text-[89px] text-[#68E1EB] font-bold">1,200</h1>
                        <p class="text-xl">Registered Players</p>
                    </div>
                    <div class="flex flex-col items-center">
                        <h1 class="text-[89px] text-[#6177F5] font-bold">50</h1>
                        <p class="text-xl">Distributors</p>
                    </div>
                    <div class="flex flex-col items-center">
                        <h1 class="text-[89px] text-[#6177F5] font-bold">500</h1>
                        <p class="text-xl">Active Players</p>
                    </div>
                </div>
            </div>
        </div>
	</main>
</Layout>

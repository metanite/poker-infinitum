---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign In | Poker Infinity">
    <div class="h-[50rem] max-w-7xl mx-auto flex">
        <div class="flex flex-col justify-center items-start w-3/5">
            <h1 class="font-extrabold text-[3.75rem]">Sign In</h1>

            <form class="flex flex-col mt-10 w-full pr-32">
                <input 
                    type="text" 
                    id="email" 
                    class="bg-[#212121] bg-[url('/mail.svg')] bg-no-repeat bg-[center_left_1rem] pl-10 pr-3 py-4 rounded text-[#807E7E] text-sm placeholder:text-sm placeholder:text-[#807E7E] tracking-wide" 
                    placeholder="Email"
                >
                <input 
                    type="password" 
                    id="password" 
                    class="bg-[#212121] px-3 py-4 mt-4 rounded text-[#807E7E] text-sm placeholder:text-sm placeholder:text-[#807E7E] tracking-wide" 
                    placeholder="Enter your password"
                >
                <div class="relative mt-6 flex">  
                    <input 
                        type="checkbox" 
                        checked 
                        id="checkbox"
                        class="invisible"
                    >
                    <label 
                        for="checkbox"
                        class="text-sm rounded-full cursor-pointer w-5 h-5 absolute left-0 top-0 border border-white p-2 after:content-[''] after:border-2 after:border-white after:border-t-0 after:border-r-0 after:left-[3px] after:top-[5px] after:-rotate-45 after:absolute after:h-1.5 after:w-3 after:opacity-0"    
                    >
                    </label>
                    <p class="text-sm ml-4 tracking-wide">Remember me</p>
                </div>
                <button 
                    type="submit" 
                    class="px-16 py-3 bg-blue text-white font-semibold tracking-wide rounded outline-none text-[1.125rem] mt-6"
                >
                    Sign In
                </button>
            </form>

            <div class="flex flex-col space-y-1 mt-6">
                <a href="/#" class="text-sm tracking-wide">Forgot Password?</a>
                <a href="/signup" class="text-sm tracking-wide">Don't have an account yet?</a>
            </div>
        </div>
        <div class="bg-gray-light flex items-center w-full">
            <img src="/img/onboarding.png" class="">
        </div>
    </div>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import Payments from '../components/Payments.astro';
import Features from '../components/Features.astro';
---

<Layout title="Deposits and Withdrawals | Poker Infinity">
    <div class="max-w-7xl mx-auto mt-[6.25rem]">
        <div class="flex items-center justify-center">
            <div class="w-3/5 flex flex-col">
                <h1 class="font-extrabold text-6xl tracking-wide leading-tight">Real Money Deposits & Withdrawals</h1>
                <p class="text-xl tracking-wide leading-snug mt-[1.75rem]">
                    We always make sure that our users have the most secure and reliable payment systems while and after playing our app.
                </p>
            </div>
            <div class="w-2/5">
                <img src="/img/coins.png" alt="coins entering into a smartphone" class="mx-auto">
            </div>
        </div>
    </div>
    <div class="mt-[100px]">
        <Payments />
    </div>
    <div class="pt-[166px] pb-[195px]">
        <Features />
    </div>
</Layout>
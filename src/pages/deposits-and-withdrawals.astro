---
import Layout from '../layouts/Layout.astro';
import Payments from '../components/Payments.astro';
import Features from '../components/Features.astro';
---

<Layout title="Deposits and Withdrawals | Poker Infinity">
    <div class="w-[85%] 2xl:w-auto max-w-7xl mx-auto mt-5 lg:mt-[6.25rem] px-16 lg:px-0">
        <div class="flex flex-col lg:flex-row items-center justify-center">
            <div class="lg:w-3/5 flex flex-col order-2 lg:order-1">
                <h1 class="font-extrabold text-5xl md:text-6xl text-center lg:text-left tracking-wide leading-tight">Real Money Deposits & Withdrawals</h1>
                <p class="tex-sm md:text-lg lg:text-xl text-center lg:text-left tracking-wide leading-relaxed mt-[1.75rem]">
                    We always make sure that our users have the most secure and reliable payment systems while and after playing our app.
                </p>
            </div>
            <div class="w-full lg:w-2/5 order-1 lg:order-2">
                <img src="/img/coins.png" alt="coins entering into a smartphone" class="mx-auto">
            </div>
        </div>
    </div>
    <div class="mt-[100px]">
        <Payments />
    </div>
    <div class="pt-[166px] pb-[195px]">
        <Features />
    </div>
</Layout>
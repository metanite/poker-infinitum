---

---

<nav aria-label="Global">
    <div class="max-w-7xl px-4 sm:px-10 xl:px-4 mx-auto flex items-center justify-between w-full py-[17px]">
        <div class="flex items-center justify-between w-full lg:w-auto">
            <div>
                <img src="/img/logo.png" alt="poker infinity logo" class="md:mr-8 lg:mr-4 xl:mr-[4.375rem]">
            </div>

            <div class="hidden md:space-x-4 lg:space-x-2 lg:flex xl:space-x-11">
                <a href="/" rel="noopener noreferrer" class="font-semibold text-sm">Home</a>
                <a href="/how-to-play" rel="noopener noreferrer" class="flex items-center font-semibold text-sm">
                    How To Play
                    <span class="ml-3">
                        <svg id="Icon_Arrows_Chevron_Down" data-name="Icon/Arrows/Chevron/Down" xmlns="http://www.w3.org/2000/svg" width="8" height="4.444" viewBox="0 0 8 4.444">
                            <path id="Icon_Color" data-name="Icon Color" d="M3.686.13a.444.444,0,0,1,.672.579l-.043.05L1.073,4,4.314,7.241a.445.445,0,0,1,.043.579l-.043.05a.445.445,0,0,1-.579.043l-.05-.043L.13,4.314a.445.445,0,0,1-.043-.579l.043-.05Z" transform="translate(0 4.444) rotate(-90)" fill="#fff"/>
                        </svg>                      
                    </span>
                </a>
                <a href="/deposits-and-withdrawals" rel="noopener noreferrer" class="font-semibold text-sm">Deposits & Withdrawals</a>
                <a href="/tournaments" rel="noopener noreferrer" class="font-semibold text-sm">Tournaments</a>
            </div>
            <div class="flex items-center lg:hidden">
                <button type="button" id="hamburger-menu" aria-pressed="false">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 30 21">
                        <g id="Icon_feather-menu" data-name="Icon feather-menu" transform="translate(-3 -7.5)">
                          <path id="Path_30799" data-name="Path 30799" d="M4.5,18h27" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                          <path id="Path_30800" data-name="Path 30800" d="M4.5,9h27" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                          <path id="Path_30801" data-name="Path 30801" d="M4.5,27h27" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                        </g>
                    </svg>                      
                </button>
            </div>
        </div>

        <div class="hidden lg:flex space-x-4">
            <a href="/login" class="button px-[35px] py-2.5 bg-blue text-base tracking-wide rounded font-semibold">Login</a>
            <a href="/signup" class="button px-[35px] py-2.5 border border-blue text-blue text-base tracking-wide rounded font-semibold">Sign Up</a>
        </div>
    </div>

    <div class="hidden lg:hidden" id="mobile-nav">
        <div class="bg-gray-dark border-b border-white w-full h-auto">
            <div class="px-10 sm:px-16">
                <div class="pt-20 flex flex-col space-y-5">
                    <a href="/" rel="noopener noreferrer" class="font-semibold text-xl">Home</a>
                    <a href="/how-to-play" rel="noopener noreferrer" class="flex items-center font-semibold text-xl">
                        How To Play
                        <span class="ml-3">
                            <svg id="Icon_Arrows_Chevron_Down" data-name="Icon/Arrows/Chevron/Down" xmlns="http://www.w3.org/2000/svg" width="8" height="4.444" viewBox="0 0 8 4.444">
                                <path id="Icon_Color" data-name="Icon Color" d="M3.686.13a.444.444,0,0,1,.672.579l-.043.05L1.073,4,4.314,7.241a.445.445,0,0,1,.043.579l-.043.05a.445.445,0,0,1-.579.043l-.05-.043L.13,4.314a.445.445,0,0,1-.043-.579l.043-.05Z" transform="translate(0 4.444) rotate(-90)" fill="#fff"/>
                            </svg>                      
                        </span>
                    </a>
                    <a href="/deposits-and-withdrawals" rel="noopener noreferrer" class="font-semibold text-xl">Deposits & Withdrawals</a>
                    <a href="/tournaments" rel="noopener noreferrer" class="font-semibold text-xl">Tournaments</a>
                </div>
                <div class="flex space-x-3 mt-10 pb-10">
                    <a href="/login" class="button px-[35px] py-2.5 bg-blue text-base tracking-wide rounded font-semibold">Login</a>
                    <a href="/signup" class="button px-[35px] py-2.5 border border-blue text-blue text-base tracking-wide rounded font-semibold">Sign Up</a>
                </div>
            </div>
            
        </div>
    </div>
</nav>

<script is:inline>
    const button = document.querySelector("#hamburger-menu");
    const nav = document.querySelector("#mobile-nav");

    button.addEventListener("click", () => {
    button.toggleAttribute("aria-pressed");
    button.getAttribute("aria-pressed") === null ? nav.classList.remove('hidden') : nav.classList.add('hidden');
    button.innerHTML = button.getAttribute("aria-pressed") === null
        ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 stroke-current fill-transparent" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg><span class="sr-only">Close sidebar</span>`
        : ` <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 30 21">
                <g id="Icon_feather-menu" data-name="Icon feather-menu" transform="translate(-3 -7.5)">
                    <path id="Path_30799" data-name="Path 30799" d="M4.5,18h27" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                    <path id="Path_30800" data-name="Path 30800" d="M4.5,9h27" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                    <path id="Path_30801" data-name="Path 30801" d="M4.5,27h27" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"/>
                </g>
            </svg><span class="sr-only">Toggle sidebar</span>`;
    });

</script>
---
const { image, alt, title, description } = Astro.props;
---

<div class="flex flex-col items-center justify-center">
    <div>
        <img src={image} alt={alt} />
    </div>
    <div class="mt-[1.1625rem]"> 
        <h1 class="font-extrabold text-3xl tracking-wide leading-normal text-center">{title}</h1>
    </div>
    <div class="flex justify-center">
        <p class="w-[80%] text-sm tracking-wide leading-normal text-center">{description}</p>
    </div>
</div>